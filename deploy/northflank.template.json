{
  "apiVersion": "v1.2",
  "name": "Open Construction ERP",
  "description": "Private bootstrap deployment with PostgreSQL and persistent application storage.",
  "arguments": {
    "projectName": "Norwegian Construction ERP",
    "region": "europe-west",
    "repositoryUrl": "https://github.com/tromsobyggtre-beep/norwegian-construction-ai-agent",
    "branch": "main",
    "appPlan": "nf-compute-100-4",
    "databasePlan": "nf-compute-50",
    "buildPlan": "nf-compute-400-16",
    "databaseStorageMB": 10240,
    "appStorageMB": 10240,
    "appOrigin": "https://example.invalid",
    "publicHttp": false
  },
  "options": {
    "autorun": false,
    "concurrencyPolicy": "forbid"
  },
  "spec": {
    "kind": "Workflow",
    "spec": {
      "type": "sequential",
      "steps": [
        {
          "kind": "Project",
          "ref": "project",
          "spec": {
            "name": "${args.projectName}",
            "region": "${args.region}",
            "networking": {
              "allowedIngressProjects": []
            }
          }
        },
        {
          "kind": "Workflow",
          "spec": {
            "type": "sequential",
            "context": {
              "projectId": "${refs.project.id}"
            },
            "steps": [
              {
                "kind": "Addon",
                "ref": "postgres",
                "spec": {
                  "name": "erp-postgres",
                  "type": "postgresql",
                  "version": "16-latest",
                  "tlsEnabled": true,
                  "externalAccessEnabled": false,
                  "billing": {
                    "deploymentPlan": "${args.databasePlan}",
                    "storage": "${args.databaseStorageMB}",
                    "replicas": 1
                  },
                  "typeSpecificSettings": {
                    "postgresqlConnectionPoolerEnabled": false
                  },
                  "backupSchedules": [
                    {
                      "scheduling": {
                        "interval": "daily",
                        "hour": [3],
                        "minute": [15]
                      },
                      "backupType": "dump",
                      "retentionTime": 7
                    }
                  ]
                }
              },
              {
                "kind": "Condition",
                "spec": {
                  "kind": "Addon",
                  "spec": {
                    "type": "running",
                    "data": {
                      "addonId": "${refs.postgres.id}"
                    }
                  }
                }
              },
              {
                "kind": "SecretGroup",
                "ref": "secrets",
                "spec": {
                  "name": "erp-runtime",
                  "type": "secret",
                  "secretType": "environment",
                  "priority": 10,
                  "restrictions": {
                    "restricted": false
                  },
                  "secrets": {
                    "variables": {
                      "JWT_SECRET": "${fn.randomSecret(64, 'hex')}",
                      "PGSSLMODE": "require"
                    }
                  },
                  "addonDependencies": [
                    {
                      "addonId": "${refs.postgres.id}",
                      "keys": [
                        { "keyName": "HOST", "aliases": ["OE_DB_HOST"] },
                        { "keyName": "PORT", "aliases": ["OE_DB_PORT"] },
                        { "keyName": "USERNAME", "aliases": ["OE_DB_USER"] },
                        { "keyName": "PASSWORD", "aliases": ["OE_DB_PASSWORD"] },
                        { "keyName": "DATABASE", "aliases": ["OE_DB_NAME"] }
                      ]
                    }
                  ]
                }
              },
              {
                "kind": "Volume",
                "ref": "data",
                "spec": {
                  "name": "erp-data",
                  "mounts": [
                    { "containerMountPath": "/data" }
                  ],
                  "spec": {
                    "accessMode": "ReadWriteOnce",
                    "storageSize": "${args.appStorageMB}"
                  },
                  "backupSchedules": [
                    {
                      "scheduling": {
                        "interval": "daily",
                        "hour": [3],
                        "minute": [30]
                      },
                      "retentionTime": 7
                    }
                  ]
                }
              },
              {
                "kind": "CombinedService",
                "ref": "app",
                "spec": {
                  "name": "open-construction-erp",
                  "billing": {
                    "deploymentPlan": "${args.appPlan}",
                    "buildPlan": "${args.buildPlan}"
                  },
                  "deployment": {
                    "instances": 1,
                    "docker": {
                      "configType": "default"
                    },
                    "storage": {
                      "ephemeralStorage": {
                        "storageSize": 1024
                      }
                    },
                    "gracePeriodSeconds": 60
                  },
                  "createOptions": {
                    "volumesToAttach": ["${refs.data.id}"]
                  },
                  "vcsData": {
                    "projectType": "github",
                    "projectUrl": "${args.repositoryUrl}",
                    "projectBranch": "${args.branch}"
                  },
                  "buildSettings": {
                    "dockerfile": {
                      "buildEngine": "buildkit",
                      "dockerFilePath": "/Dockerfile",
                      "dockerWorkDir": "/"
                    }
                  },
                  "disabledCI": false,
                  "buildConfiguration": {
                    "pathIgnoreRules": ["docs/**", "**/*.md"],
                    "isAllowList": false,
                    "ciIgnoreFlagsEnabled": true
                  },
                  "runtimeEnvironment": {
                    "APP_ENV": "production",
                    "APP_DEBUG": "false",
                    "PORT": "8080",
                    "SERVE_FRONTEND": "true",
                    "SEED_DEMO": "false",
                    "OE_REGISTRATION_MODE": "closed",
                    "OE_DATA_DIR": "/data",
                    "VECTOR_BACKEND": "lancedb",
                    "VECTOR_DATA_DIR": "/data/vectors",
                    "REDIS_URL": "",
                    "ALLOWED_ORIGINS": "${args.appOrigin}",
                    "FRONTEND_URL": "${args.appOrigin}"
                  },
                  "ports": [
                    {
                      "name": "http",
                      "internalPort": 8080,
                      "protocol": "HTTP",
                      "public": "${args.publicHttp}"
                    }
                  ],
                  "healthChecks": [
                    {
                      "protocol": "HTTP",
                      "type": "startupProbe",
                      "path": "/api/health",
                      "port": 8080,
                      "initialDelaySeconds": 10,
                      "periodSeconds": 10,
                      "timeoutSeconds": 5,
                      "failureThreshold": 90
                    },
                    {
                      "protocol": "HTTP",
                      "type": "readinessProbe",
                      "path": "/api/health",
                      "port": 8080,
                      "initialDelaySeconds": 10,
                      "periodSeconds": 10,
                      "timeoutSeconds": 5,
                      "failureThreshold": 3,
                      "successThreshold": 1
                    },
                    {
                      "protocol": "HTTP",
                      "type": "livenessProbe",
                      "path": "/api/health",
                      "port": 8080,
                      "initialDelaySeconds": 30,
                      "periodSeconds": 30,
                      "timeoutSeconds": 5,
                      "failureThreshold": 5
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  }
}
